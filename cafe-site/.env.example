# Подключение к базе. Два адреса нужны обязательно:
#
#   DATABASE_URL — приложение. Через transaction pooler (порт 6543).
#                  Параметр pgbouncer=true обязателен: без него Prisma готовит
#                  запросы на сервере, а pooler их не поддерживает.
#   DIRECT_URL   — миграции и сиды. Через session pooler (порт 5432):
#                  DDL требует сессии и через 6543 не проходит.
#
# Supabase: строка берётся в Settings → Database → Connection string → URI.
# Прямой адрес db.<ref>.supabase.co даёт только IPv6 — если у машины нет IPv6,
# работать будет ТОЛЬКО через pooler.
#
# Спецсимволы в пароле обязательно URL-кодировать: ! → %21, @ → %40, # → %23.
# Незакодированный @ разделит пароль и хост, # обрежет строку.
DATABASE_URL="postgresql://postgres.<ref>:<пароль>@aws-0-<регион>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<пароль>@aws-0-<регион>.pooler.supabase.com:5432/postgres?sslmode=require"

# Локальный Postgres вместо облака (через UNIX-сокет):
# DATABASE_URL="postgresql://<пользователь>@localhost:5433/ntm?host=%2Fпуть%2Fк%2Fсокету&schema=public"
# DIRECT_URL="postgresql://<пользователь>@localhost:5433/ntm?host=%2Fпуть%2Fк%2Fсокету&schema=public"

# Ключ подписи сессий администратора. Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET="<случайная строка не короче 32 символов>"

# Уведомления о бронированиях в Telegram (необязательно)
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""
